diff --git a/src/test/unittests/base/CoreTeardownTests.cpp b/src/test/unittests/base/CoreTeardownTests.cpp
new file mode 100644
index 0000000..a8ef4b2
--- /dev/null
+++ b/src/test/unittests/base/CoreTeardownTests.cpp
@@ -0,0 +1,65 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#include "base/EventQueue.h"
+#include "arch/Arch.h"
+#include "arch/XArch.h"
+#include "net/ISocketMultiplexerJob.h"
+#include "net/SocketMultiplexer.h"
+#include "net/TCPSocket.h"
+#include <gtest/gtest.h>
+#include <memory>
+#include <atomic>
+#include <chrono>
+#include <thread>
+
+TEST(CoreTeardownTests, stopIsIdempotentAndSocketCleanupIsSafe) {
+  EventQueue events;
+  SocketMultiplexer multiplexer;
+  auto socket = std::make_unique<TCPSocket>(&events, &multiplexer);
+  multiplexer.stop();
+  multiplexer.removeSocket(socket.get());
+  socket.reset();
+  multiplexer.stop();
+}
+
+namespace {
+class CancelledSocketJob : public ISocketMultiplexerJob {
+public:
+  explicit CancelledSocketJob(std::atomic<bool> &entered)
+      : m_socket(ARCH->newSocket(IArchNetwork::kINET, IArchNetwork::kDGRAM)),
+        m_entered(entered) {}
+  ~CancelledSocketJob() override { ARCH->closeSocket(m_socket); }
+  ArchSocket getSocket() const override { return m_socket; }
+  bool isReadable() const override { return false; }
+  bool isWritable() const override { return true; }
+  ISocketMultiplexerJob *run(bool, bool, bool) override {
+    m_entered = true;
+    throw XThreadCancel();
+  }
+private:
+  ArchSocket m_socket;
+  std::atomic<bool> &m_entered;
+};
+}
+
+TEST(CoreTeardownTests, cancelledCallbackDoesNotStrandCleanupLocks) {
+  EventQueue events;
+  SocketMultiplexer multiplexer;
+  auto socket = std::make_unique<TCPSocket>(&events, &multiplexer);
+  std::atomic<bool> entered(false);
+  multiplexer.addSocket(socket.get(), new CancelledSocketJob(entered));
+  for (int attempt = 0; attempt < 50 && !entered; ++attempt) {
+    std::this_thread::sleep_for(std::chrono::milliseconds(5));
+  }
+  EXPECT_TRUE(entered);
+  multiplexer.stop();
+  multiplexer.removeSocket(socket.get());
+  socket.reset();
+}
+
+#ifdef __APPLE__
+#include "platform/OSXEventQueueBuffer.h"
+TEST(CoreTeardownTests, uninitializedCarbonQueueRejectsEvents) {
+  OSXEventQueueBuffer buffer(nullptr);
+  EXPECT_FALSE(buffer.addEvent(42));
+}
+#endif
