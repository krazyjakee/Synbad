+void SocketMultiplexer::stop() {
+  if (m_thread == nullptr) {
+    return;
+  }
+  m_thread->cancel();
+  m_thread->unblockPollSocket();
+  m_thread->wait();
+  // pollSocket()/job callbacks can unwind on cancellation while owning
+  // these logical locks. The old destructor just deleted them; stop()
+  // must release the departed worker's locks for subsequent socket cleanup.
+  {
+    Lock lock(m_mutex);
+    if (m_jobListLocker != nullptr && *m_jobListLocker == *m_thread) {
+      delete m_jobListLocker;
+      m_jobListLocker = nullptr;
+      *m_jobListLock = false;
+      m_jobListLock->broadcast();
+    }
+    if (m_jobListLockLocker != nullptr && *m_jobListLockLocker == *m_thread) {
+      delete m_jobListLockLocker;
+      m_jobListLockLocker = nullptr;
+      *m_jobListLockLocked = false;
+      m_jobListLockLocked->broadcast();
+    }
+  }
+  delete m_thread;
+  m_thread = nullptr;
+}
